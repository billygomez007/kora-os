NODE_ENV=development
PORT=3000
API_PREFIX=v1

POSTGRES_DB=kora
POSTGRES_USER=kora_app
POSTGRES_PASSWORD=kora_local_development_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://kora_app:kora_local_development_only@127.0.0.1:5433/kora?schema=public

# Signing secret for short-lived access tokens (HS256). Required in every
# environment; production must set an explicit, strong value — there is no
# fallback. Generate a local value with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
# Access token lifetime, e.g. "15m", "1h".
JWT_ACCESS_TTL=15m

# Extra secret mixed into the hash of opaque refresh tokens before storage,
# so a refresh token cannot be replayed from a database-only leak alone.
# Required in every environment; generate with:
#   openssl rand -base64 48
REFRESH_TOKEN_PEPPER=
# Refresh token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Kora is passwordless (docs/SECURITY.md section 6): every sign-in is an
# emailed one-time code. OTP_PEPPER keys the HMAC-SHA256 digest stored
# instead of the code itself — the code is never persisted anywhere, in
# any form, and this pepper is what stands in for a password hashing
# function. Required in every environment; generate with:
#   openssl rand -base64 48
OTP_PEPPER=
# At least 6 (docs task requirement); digits only.
OTP_CODE_LENGTH=6
# How long a requested code stays valid.
OTP_EXPIRY_MINUTES=10
# A challenge locks after this many wrong codes.
OTP_MAX_ATTEMPTS=5
# Minimum gap between two codes requested for the same email.
OTP_RESEND_COOLDOWN_SECONDS=60
# Abuse limits, both required (docs task Phase B): requesting a code
# invalidates any still-active code for that email, but the ability to
# request a fresh one is itself rate-limited by both dimensions below, so
# repeated resends cannot be used to reset accumulated attempt limits for
# free.
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
