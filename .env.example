NODE_ENV=development
PORT=3000
API_PREFIX=v1

POSTGRES_DB=kora
POSTGRES_USER=kora_app
POSTGRES_PASSWORD=kora_local_development_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://kora_app:kora_local_development_only@127.0.0.1:5433/kora?schema=public

# Signing secret for short-lived access tokens (HS256). Required in every
# environment; production must set an explicit, strong value — there is no
# fallback. Generate a local value with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
# Access token lifetime, e.g. "15m", "1h".
JWT_ACCESS_TTL=15m

# Extra secret mixed into the hash of opaque refresh tokens before storage,
# so a refresh token cannot be replayed from a database-only leak alone.
# Required in every environment; generate with:
#   openssl rand -base64 48
REFRESH_TOKEN_PEPPER=
# Refresh token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Kora is passwordless (docs/SECURITY.md section 6): every sign-in is an
# emailed one-time code. OTP_PEPPER keys the HMAC-SHA256 digest stored
# instead of the code itself — the code is never persisted anywhere, in
# any form, and this pepper is what stands in for a password hashing
# function. Required in every environment; generate with:
#   openssl rand -base64 48
OTP_PEPPER=
# At least 6 (docs task requirement); digits only.
OTP_CODE_LENGTH=6
# How long a requested code stays valid.
OTP_EXPIRY_MINUTES=10
# A challenge locks after this many wrong codes.
OTP_MAX_ATTEMPTS=5
# Minimum gap between two codes requested for the same email.
OTP_RESEND_COOLDOWN_SECONDS=60
# Abuse limits, both required (docs task Phase B): requesting a code
# invalidates any still-active code for that email, but the ability to
# request a fresh one is itself rate-limited by both dimensions below, so
# repeated resends cannot be used to reset accumulated attempt limits for
# free.
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# Optional production setting. Populate only with the current Cloudflare
# published proxy CIDRs after the API hostname is proxied. The API trusts
# CF-Connecting-IP only when the immediate peer matches one of these ranges.
# CLOUDFLARE_TRUSTED_PROXY_CIDRS=

# Email delivery (docs/SECURITY.md section 6). Leaving EMAIL_DELIVERY_MODE
# unset is always valid: EmailOtpModule then fails closed rather than
# pretending to deliver — there is no console/stdout fallback. Accepted
# values are "smtp" and "resend". These values below are safe, non-secret
# defaults pointing at the local Mailpit container `pnpm db:up` starts
# (infrastructure/compose.yaml) — inspect delivered codes at
# http://127.0.0.1:8025. Production should use the Resend HTTPS example
# below rather than attempting outbound SMTP from Railway.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit accepts unauthenticated SMTP locally; leave both blank.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kora OS <no-reply@kora.local>"

# --- Production example (Resend HTTPS API) ---------------------------
# Do not uncomment these locally and do not put a real API key in this
# file, any other committed file, a test, or a log. Set the real values
# only in the production hosting provider's secret manager. Full setup
# walkthrough: docs/operations/EMAIL_OTP_PRODUCTION_SETUP.md.
#
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=            # from the secret manager only
# OTP_FROM_EMAIL="Kora OS <login@koraafric.com>"
# INVITATION_FROM_EMAIL="Kora OS Invitations <invite@koraafric.com>"
# Public web base URL used in staff invitation links.
# KORA_WEB_URL=https://koraafric.com
