<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  Allows local development over HTTP for:
  - Android emulator host alias: 10.0.2.2
  - Physical Android device using `adb reverse`: 127.0.0.1

  This file is only packaged in debug builds.
  Release builds continue to use the HTTPS-only base configuration.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
