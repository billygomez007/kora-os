<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of src/main/res/xml/network_security_config.xml
  (same resource path, so Gradle's debug source set replaces the base
  one only for debug builds). Permits cleartext HTTP solely to the
  Android emulator's host-loopback alias, matching the debug default API
  base URL (http://10.0.2.2:3000/v1/). Never packaged into a release
  build, which always enforces HTTPS-only via the base config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
